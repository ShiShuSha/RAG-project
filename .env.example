# Скопируйте файл в .env и раскомментируйте нужные строки.
# Все параметры необязательны: проект работает и без .env.

# --- Индексация -----------------------------------------------------------
# RAG_DATA_DIR=data
# RAG_CHROMA_DIR=.chroma
# RAG_COLLECTION=knowledge_base
# RAG_CHUNK_SIZE=500          # длина чанка в символах
# RAG_CHUNK_OVERLAP=50        # перекрытие в символах
# RAG_TOP_K=3
# RAG_MIN_RELEVANCE=0.10      # ниже порога — отказ без вызова LLM

# --- Эмбеддинги -----------------------------------------------------------
# auto | sentence-transformers | hashing
# EMBEDDING_PROVIDER=auto
# EMBEDDING_MODEL=cointegrated/rubert-tiny2
# ALLOW_MODEL_DOWNLOAD=true

# --- LLM ------------------------------------------------------------------
# auto | ollama | openai | yandex | extractive
# LLM_PROVIDER=auto
# LLM_MODEL=llama3.2

# Локальная Ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Любой OpenAI-совместимый API
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# YandexGPT (OpenAI-совместимый endpoint)
# YANDEX_API_KEY=...
# YANDEX_FOLDER_ID=...
# YANDEX_MODEL=yandexgpt-lite/latest
